# ===== LemaClipper - configuración =====
# Copia este archivo como .env y pon tu API key.

# Tu API key de Anthropic (https://console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-PEGA_AQUI_TU_KEY

# Modelo de Claude que escoge los clips y entiende tus comandos de edición
CLAUDE_MODEL=claude-sonnet-5-5

# Modelo de Whisper: tiny | base | small | medium
# small = buen balance en tu laptop. base = más rápido, un poco menos preciso.
WHISPER_MODEL=small

# Idioma principal del audio (es = español). Déjalo vacío para autodetectar.
IDIOMA=es

# Cuántos clips quieres por video (máximo)
MAX_CLIPS=6

# Duración de cada clip en segundos
DURACION_MIN=15
DURACION_MAX=58

# Formato vertical: blur (gameplay completo con fondo borroso) | crop (recorte al centro)
MODO_VERTICAL=blur

# Subtítulos quemados en el video: si | no
SUBTITULOS=si

# Puerto de la página web
PUERTO=3000

# Comando de Python (en Windows normalmente "python")
PYTHON_CMD=python
